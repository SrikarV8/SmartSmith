# Copy to .env and fill in your own keys. Never commit .env.
# Choose a provider: "openai" (default) or "gemini" (free tier available)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...   # needed when LLM_PROVIDER=gemini; run schema_gemini.sql and migrate_to_gemini.py once
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_KEY=<your Supabase secret / service_role key>
TAVILY_API_KEY=tvly-...
# Optional overrides
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest   # tried in order
# EMBEDDING_PROVIDER=local        # local (free, default with Gemini) or same as LLM_PROVIDER
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
